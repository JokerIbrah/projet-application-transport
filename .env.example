# Base SQLite produite par gtfs_metz/loader.py
GTFS_DB=data/gtfs.sqlite

# Flux GTFS-RT du réseau Le Met'.
# Laisser vide pour fonctionner sur les seuls horaires théoriques.
# Accepte une URL http(s) ou un chemin de fichier local, ce qui permet de
# rejouer hors connexion les échantillons rangés dans gtfs_metz/.
GTFS_RT_TRIP_UPDATES=
GTFS_RT_VEHICLE_POSITIONS=

# Intervalle de rafraîchissement, en secondes
GTFS_RT_INTERVAL=30
